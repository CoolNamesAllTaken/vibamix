#!/usr/bin/env bash
# Wrapper for probe-rs: the nRF Connect VS Code extension passes --probe with
# just a serial number, but probe-rs requires VID:PID:Serial format.
# This script looks up the full selector from `probe-rs list` output.

PROBE_RS_BIN="${PROBE_RS_BIN:-probe-rs}"

fix_probe_serial() {
    local serial="$1"
    [[ "$serial" == *:* ]] && echo "$serial" && return
    # probe-rs list line looks like: [N]: Name -- VID:PID-N:SERIAL (type)
    local vid_pid
    vid_pid=$("$PROBE_RS_BIN" list 2>/dev/null \
        | grep -i "$serial" \
        | grep -oE '[0-9a-fA-F]{4}:[0-9a-fA-F]{4}' \
        | head -1)
    [[ -n "$vid_pid" ]] && echo "${vid_pid}:${serial}" || echo "$serial"
}

new_args=()
args=("$@")
is_gdb=0
gdb_port=1337
i=0
while (( i < ${#args[@]} )); do
    arg="${args[$i]}"
    if [[ "$arg" == "--probe" ]]; then
        (( i++ ))
        new_args+=("--probe" "$(fix_probe_serial "${args[$i]}")")
    elif [[ "$arg" == "gdb" ]]; then
        is_gdb=1
        new_args+=("$arg")
    elif [[ "$arg" == "--gdb-connection-string" ]]; then
        new_args+=("$arg")
        (( i++ ))
        # host:port — grab the trailing port so detection matches an overridden port.
        gdb_port="${args[$i]##*:}"
        new_args+=("${args[$i]}")
    else
        new_args+=("$arg")
    fi
    (( i++ ))
done

# Idempotent gdb launch: if a probe-rs gdb server is already listening on the target
# port (e.g. left running after a debug-session restart), don't try to spawn a second
# one — it would fail to bind the port and hang VS Code's preLaunchTask. Emit the
# sentinel the tasks.json problemMatcher waits for and exit so cortex-debug attaches to
# the existing server.
# Check both IPv4 (127.0.0.1) and IPv6 (::1): probe-rs binds localhost, which on
# many systems resolves to the IPv6 ::1 only. An IPv4-only check would miss that
# server and try to spawn a second one, which then fails to bind the port.
if (( is_gdb )) && { nc -z 127.0.0.1 "$gdb_port" 2>/dev/null || nc -z ::1 "$gdb_port" 2>/dev/null; }; then
    echo "Firing up GDB stub"
    exit 0
fi

exec "$PROBE_RS_BIN" "${new_args[@]}"
